# ---------- Database (PostgreSQL + pgvector) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workforceiq

# ---------- Express backend ----------
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ML_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8002
SERVICE_TIMEOUT_MS=120000

# ---------- RAG service ----------
# Embeddings: sentence-transformers (default, downloads all-MiniLM-L6-v2 on first run, 384 dims)
EMBEDDING_MODE=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODE=hashing   # TEST-ONLY offline mode; responses are labelled with the mode used

# LLM for grounded explanations. Any OpenAI-compatible chat-completions endpoint.
#   Groq:     LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   xAI Grok: LLM_BASE_URL=https://api.x.ai/v1              LLM_MODEL=grok-3-mini
# If LLM_API_KEY is empty or the call fails, reasons are generated by a rule-based fallback
# and clearly labelled "Fallback" in the UI.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30

# ---------- Frontend (Vite) ----------
VITE_API_BASE_URL=http://localhost:4000/api
